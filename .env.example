# Desenvolvimento local. No Compose, a conexão interna usa o serviço db.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="easyfood"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easyfood"
PORT="3000"

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Opcional: exige uma chave do Resend e um remetente autorizado pelo serviço.
EMAIL_ENABLED="false"
EMAIL_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="EasyFood"
EMAIL_TO=""

# Apenas para dados de demonstração; o seed é uma ação explícita.
SEED_USER_EMAIL="demo@easyfood.local"
SEED_USER_PASSWORD="easyfood123"
